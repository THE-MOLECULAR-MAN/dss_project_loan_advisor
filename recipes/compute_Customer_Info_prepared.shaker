  "steps": [
    {
      "preview": false,
      "mainColor": "#2ab1ac",
      "name": "AI steps for Parse Date_Of_Birth and create a column Age that tells me the time in years between now and Date_Of_Birth",
      "metaType": "GROUP",
      "disabled": false,
      "comment": "Steps can only be regenerated when this group is in last position",
      "steps": [
        {
          "preview": false,
          "metaType": "PROCESSOR",
          "disabled": false,
          "type": "DateParser",
          "params": {
            "outCol": "Date_Of_Birth_parsed",
            "formats": [
              "yyyy-dd-MM"
            ],
            "columns": [
              "Date_Of_Birth"
            ],
            "timezone_id": "UTC",
            "appliesTo": "SINGLE_COLUMN",
            "lang": "auto",
            "outType": {
              "name": "out",
              "type": "date"
            }
          },
          "alwaysShowComment": false
        },
        {
          "preview": false,
          "metaType": "PROCESSOR",
          "disabled": false,
          "type": "DateDifference",
          "params": {
            "output": "Age",
            "excludeHolidays": false,
            "excludeWeekends": false,
            "calendar_id": "FR",
            "outputUnit": "YEARS",
            "input1": "Date_Of_Birth_parsed",
            "timezone_id": "use_preferred_timezone",
            "compareTo": "NOW",
            "reverse": false
          },
          "alwaysShowComment": false
        }
      ],
      "alwaysShowComment": false,
      "secondaryColor": "#d4e7e4"
    },
    {
      "preview": false,
      "metaType": "PROCESSOR",
      "disabled": false,
      "type": "ColumnsSelector",
      "params": {
        "columns": [
          "Date_Of_Birth"
        ],
        "keep": false,
        "appliesTo": "SINGLE_COLUMN"
      },
      "alwaysShowComment": false
    },
    {
      "preview": false,
      "mainColor": "#2ab1ac",
      "name": "AI steps for Write a formula that extracts the first 3 characters from FICO_Range and puts it into a new column called FICO_min",
      "metaType": "GROUP",
      "disabled": false,
      "comment": "Steps can only be regenerated when this group is in last position",
      "steps": [
        {
          "preview": false,
          "metaType": "PROCESSOR",
          "disabled": false,
          "type": "CreateColumnWithGREL",
          "params": {
            "expression": "substring(val(\"FICO_Range\"), 0, 3)",
            "column": "FICO_min",
            "errorColumn": ""
          },
          "alwaysShowComment": false
        }
      ],
      "alwaysShowComment": false,
      "secondaryColor": "#d4e7e4"
    },
    {
      "preview": false,
      "mainColor": "#2ab1ac",
      "name": "AI steps for AI steps for Write a formula that extracts the last 3 characters from FICO_Range and puts it into a new column called FICO_max",
      "metaType": "GROUP",
      "disabled": false,
      "comment": "Steps can only be regenerated when this group is in last position",
      "steps": [
        {
          "preview": false,
          "metaType": "PROCESSOR",
          "disabled": false,
          "type": "CreateColumnWithGREL",
          "params": {
            "expression": "substring(val(\"FICO_Range\"), -3)",
            "column": "FICO_max",
            "errorColumn": ""
          },
          "alwaysShowComment": false
        }
      ],
      "alwaysShowComment": false,
      "secondaryColor": "#d4e7e4"
    }
